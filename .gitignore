# Working notes — plans, specs, decisions, backlog. Kept on disk, never
# published: they are a record of how the project was built, not documentation
# anyone installing Perch needs.
docs/
.superpowers/

target/
Cargo.lock.orig
.DS_Store

# Perch's own index, if one is ever written next to the source.
*.db

# Native app build output. The xcframework and the generated UniFFI bindings
# are regenerated by scripts/build-xcframework.sh; a checked-in copy is a
# classic source of FFI bugs.
build/
apps/macos/Perch/Frameworks/
apps/macos/Perch/Sources/PerchFFI/
apps/macos/Perch/.build/
